# embed_files.cmake: cmake -DOUT=<file.cpp> -DSYMBOL=<name> -DFILES=<a.png;b.png;...> -P embed_files.cmake
# Writes a C++ file with every input as a byte array, named by its basename without extension:
#   struct EmbeddedFile { const char* name; const unsigned char* data; unsigned size; };
#   extern const EmbeddedFile <SYMBOL>[]; extern const unsigned <SYMBOL>_count;
# Used for the button-prompt icons (runtime/assets/button_prompts), so the exe needs no data folder.
set(_body "// Generated by runtime/cmake/embed_files.cmake. Do not edit.\n")
string(APPEND _body "struct EmbeddedFile { const char* name; const unsigned char* data; unsigned size; };\n")
set(_table "")
set(_i 0)
list(SORT FILES)
foreach(_f IN LISTS FILES)
    get_filename_component(_name "${_f}" NAME_WE)
    file(READ "${_f}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _body "static const unsigned char k${_i}[] = {${_bytes}};\n")
    string(APPEND _table "    {\"${_name}\", k${_i}, ${_size}u},\n")
    math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "extern const EmbeddedFile ${SYMBOL}[] = {\n${_table}};\n")
string(APPEND _body "extern const unsigned ${SYMBOL}_count = ${_i}u;\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
